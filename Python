class Student(ABC):
    """Abstract base class that stores and processes student information."""

    def __init__(self, student_id, first_name, last_name, programme, marks):
        self.__student_id = str(student_id).strip()
        self.__first_name = str(first_name).strip()
        self.__last_name = str(last_name).strip()
        self.__programme = str(programme).strip()

        if not marks:
            raise ValueError("A student must have at least one subject mark.")
        self.__marks = {}
        for subject, mark in marks.items():
            mark = float(mark)
            if not 0 <= mark <= 100:
                raise ValueError(f"{subject} mark must be between 0 and 100.")
            self.__marks[str(subject).strip()] = mark

    # Properties provide controlled access to encapsulated attributes.
    @property
    def student_id(self):
        return self.__student_id

    @property
    def first_name(self):
        return self.__first_name

    @property
    def last_name(self):
        return self.__last_name

    @property
    def full_name(self):
        return f"{self.__first_name} {self.__last_name}"

    @property
    def programme(self):
        return self.__programme

    @property
    def marks(self):
        # Return a copy so callers cannot directly change the internal dictionary.
        return self.__marks.copy()

    def update_mark(self, subject, mark):
        """Update a subject mark after validating it."""
        mark = float(mark)
        if not 0 <= mark <= 100:
            raise ValueError("Mark must be between 0 and 100.")
        if subject not in self.__marks:
            raise KeyError(f"Unknown subject: {subject}")
        self.__marks[subject] = mark

    def average_score(self):
        return sum(self.__marks.values()) / len(self.__marks)

    def grade(self):
        """Grade bands used for this assignment: A >= 70, B >= 60, C >= 50, otherwise Fail."""
        average = self.average_score()
        if average >= 70:
            return "A"
        if average >= 60:
            return "B"
        if average >= 50:
            return "C"
        return "Fail"

    @abstractmethod
    def student_category(self):
        """Subclasses must provide their own category description."""
        pass

    def generate_report(self):
        subject_lines = "\n".join(
            f"  {subject}: {mark:.1f}" for subject, mark in self.__marks.items()
        )
        return (
            f"Student ID: {self.student_id}\n"
            f"Name: {self.full_name}\n"
            f"Programme: {self.programme}\n"
            f"Student type: {self.student_category()}\n"
            f"Subject marks:\n{subject_lines}\n"
            f"Average: {self.average_score():.2f}%\n"
            f"Grade: {self.grade()}"
        )


class AIUStudent(Student):
    """Standard AIU student."""

    def student_category(self):
        return "AIU Student"


class ScholarshipStudent(AIUStudent):
    """AIU student with scholarship-related behaviour."""

    def __init__(self, student_id, first_name, last_name, programme, marks,
                 scholarship_amount=0):
        super().__init__(student_id, first_name, last_name, programme, marks)
        if float(scholarship_amount) < 0:
            raise ValueError("Scholarship amount cannot be negative.")
        self.scholarship_amount = float(scholarship_amount)

    def is_eligible(self):
        return self.average_score() >= 85

    # Method overriding: this implementation replaces AIUStudent.student_category().
    def student_category(self):
        if self.is_eligible():
            return f"Scholarship Student (eligible; amount KSh {self.scholarship_amount:,.2f})"
        return "Scholarship Student (not currently eligible)"

    def generate_report(self):
        # Overridden method extends the standard report with scholarship details.
        report = super().generate_report()
        status = "Eligible" if self.is_eligible() else "Not eligible"
        return (
            f"{report}\n"
            f"Scholarship eligibility: {status} (average must be at least 85%)\n"
            f"Scholarship amount: KSh {self.scholarship_amount:,.2f}"
        )


class PerformanceAnalyzer:
    """Analyzes a collection of Student objects (composition/has-a relationship)."""

    def __init__(self, students):
        self.students = list(students)
        if not self.students:
            raise ValueError("The analyzer needs at least one student.")

    def highest_average(self):
        return max(self.students, key=lambda student: student.average_score())

    def lowest_average(self):
        return min(self.students, key=lambda student: student.average_score())

    def class_average(self):
        return sum(student.average_score() for student in self.students) / len(self.students)

    def generate_class_summary(self):
        highest = self.highest_average()
        lowest = self.lowest_average()
        return (
            "\n========== CLASS PERFORMANCE SUMMARY ==========\n"
            f"Number of students: {len(self.students)}\n"
            f"Highest average: {highest.full_name} "
            f"({highest.average_score():.2f}%)\n"
            f"Lowest average: {lowest.full_name} "
            f"({lowest.average_score():.2f}%)\n"
            f"Overall class average: {self.class_average():.2f}%\n"
            "================================================"
        )


def flexible_average(*marks):
    """
    Flexible interface:
      flexible_average(75, 80, 70)
      flexible_average(75, 80, 70, 90)
      flexible_average([75, 80, 70])
    """
    if len(marks) == 1 and not isinstance(marks[0], (int, float)):
        try:
            marks = tuple(marks[0])
        except TypeError:
            raise ValueError("Provide numbers or one iterable of numbers.")

    if not marks:
        raise ValueError("Provide at least one mark.")

    try:
        numeric_marks = [float(mark) for mark in marks]
    except (TypeError, ValueError):
        raise ValueError("All marks must be numeric.")

    if any(mark < 0 or mark > 100 for mark in numeric_marks):
        raise ValueError("Each mark must be between 0 and 100.")

    return sum(numeric_marks) / len(numeric_marks)


def load_students(csv_path):
    """Read student rows and create the appropriate student objects."""
    students = []
    with open(csv_path, "r", newline="", encoding="utf-8-sig") as file:
        reader = csv.DictReader(file)
        required = {"StudentID", "FName", "LName", "Programme",
                    "Math", "English", "Science"}
        if not required.issubset(set(reader.fieldnames or [])):
            raise ValueError(f"CSV must contain these columns: {', '.join(sorted(required))}")

        for row in reader:
            marks = {
                "Math": float(row["Math"]),
                "English": float(row["English"]),
                "Science": float(row["Science"]),
            }
            average = flexible_average(*marks.values())
            if average >= 85:
                student = ScholarshipStudent(
                    row["StudentID"], row["FName"], row["LName"],
                    row["Programme"], marks, scholarship_amount=50000
                )
            else:
                student = AIUStudent(
                    row["StudentID"], row["FName"], row["LName"],
                    row["Programme"], marks
                )
            students.append(student)
    return students


def main():
    csv_path = Path(__file__).with_name("students.csv")
    try:
        students = load_students(csv_path)
        analyzer = PerformanceAnalyzer(students)

        print("STUDENT PERFORMANCE REPORTS")
        print("============================")
        for student in students:
            print("\n" + "-" * 48)
            print(student.generate_report())

        print(analyzer.generate_class_summary())

        print("\n========== FLEXIBLE AVERAGE DEMONSTRATION ==========")
        print(f"Three separate marks: {flexible_average(76, 81, 71):.2f}%")
        print(f"Four separate marks: {flexible_average(91, 86, 89, 93):.2f}%")
        print(f"One list of marks: {flexible_average([76, 81, 71]):.2f}%")

        print("\n========== POLYMORPHISM DEMONSTRATION ==========")
        for student in students:
            # The method called is selected according to the actual object type.
            print(f"{student.full_name}: {student.student_category()}")

    except (OSError, ValueError, KeyError) as error:
        print(f"Error: {error}")


if __name__ == "__main__":
    main()

